<%= if is_nil(@username) do %>
  <div class="min-h-screen flex items-center justify-center bg-base-200">
    <div class="card w-80 bg-base-100 shadow-xl">
      <div class="card-body">
        <h2 class="card-title text-2xl font-bold mb-4">Elixir Chat</h2>
        <form phx-submit="set_username">
          <div class="form-control gap-6">
            <input
              id="username-input"
              type="text"
              name="username"
              placeholder="Your name..."
              class="input input-bordered w-full"
              phx-hook=".UsernameInput"
              autofocus
              required
            />
            <button id="join-btn" type="submit" class="btn btn-primary w-full mt-2">Join</button>
            <script :type={Phoenix.LiveView.ColocatedHook} name=".UsernameInput">
              export default {
                mounted() {
                  this.el.addEventListener("keydown", e => {
                    if (e.key === "Enter") {
                      e.preventDefault()
                      this.el.closest("form").requestSubmit()
                    }
                  })
                }
              }
            </script>
          </div>
        </form>
      </div>
    </div>
  </div>
<% else %>
  <div class="min-h-screen bg-base-200 flex items-center justify-center p-4">
    <div class="flex flex-col w-full max-w-2xl h-[90vh] bg-base-100 rounded-xl shadow-2xl overflow-hidden">
      <div class="navbar bg-accent text-accent-content px-4">
        <div class="flex-1">
          <span class="text-xl font-bold tracking-wide">Elixir Chat</span>
        </div>
        <div class="flex-none">
          <div class="font-medium">{@username}</div>
        </div>
      </div>

      <div
        id="messages"
        class="flex-1 overflow-y-auto p-4 space-y-2"
        phx-hook="ScrollBottom"
      >
        <script :type={Phoenix.LiveView.ColocatedHook} name=".MsgUsername">
          export default {
            mounted() {
              const colors = [
                "badge-primary", "badge-secondary", "badge-accent",
                "badge-info", "badge-success", "badge-warning", "badge-error"
              ]
              const name = this.el.textContent.trim().replace(/^🤖\s*/, "")
              const hash = name.split("").reduce((acc, c) => acc + c.charCodeAt(0), 0)
              this.el.classList.add("badge", "badge-sm", colors[hash % colors.length])
            }
          }
        </script>
        <%= for msg <- @messages do %>
          <div class={["chat", if(msg.username == @username, do: "chat-end", else: "chat-start")]}>
            <div class="chat-header mb-1">
              <%= if msg.is_agent do %>
                <span id={"u-#{msg.id}"} phx-hook=".MsgUsername">🤖 {msg.username}</span>
              <% else %>
                <span id={"u-#{msg.id}"} phx-hook=".MsgUsername">{msg.username}</span>
              <% end %>
            </div>
            <div class={[
              "chat-bubble",
              if(msg.username == @username, do: "chat-bubble-primary", else: ""),
              if(msg.is_agent, do: "chat-bubble-secondary", else: "")
            ]}>
              {msg.body}
            </div>
            <div class="chat-footer opacity-40 text-xs mt-1">
              {Calendar.strftime(msg.inserted_at, "%H:%M")}
            </div>
          </div>
        <% end %>
      </div>

      <div class="p-4 border-t border-base-300">
        <.form for={@message_form} id="message-form" phx-submit="send_message" phx-hook=".ClearOnSubmit" class="flex gap-2">
          <input
            id="message-body"
            type="text"
            name="body"
            value={@message_form["body"].value}
            placeholder="Message..."
            class="input input-bordered flex-1"
            autofocus
          />
          <button type="submit" class="btn btn-primary">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
              <path d="M10.894 2.553a1 1 0 00-1.788 0l-7 14a1 1 0 001.169 1.409l5-1.429A1 1 0 009 15.571V11a1 1 0 112 0v4.571a1 1 0 00.725.962l5 1.428a1 1 0 001.17-1.408l-7-14z" />
            </svg>
          </button>
        </.form>
        <script :type={Phoenix.LiveView.ColocatedHook} name=".ClearOnSubmit">
          export default {
            mounted() {
              this.el.addEventListener("submit", () => {
                const input = this.el.querySelector("input[name='body']")
                if (input) requestAnimationFrame(() => { input.value = ""; input.focus() })
              })
            }
          }
        </script>
      </div>
    </div>
  </div>
<% end %>
